/* CLRS BFS distance (s -> t) on a directed unweighted graph.
   Input: [n, m, s, t, u1, v1, ..., um, vm] (optional trailing padding ignored).
   Styio: textbook BFS with local dist[] + queue[] arrays (range-materialized).
   Output: distance, or -1 if unreachable. */
values <- @stdin: list[i32]
answer = -1

?(values.length >= 4) => {
    n = values[0]
    m = values[1]
    s = values[2]
    t = values[3]
    edge_end = 4 + m + m

    ?(n > 0 && s >= 0 && s < n && t >= 0 && t < n) => {
        ?(values.length >= edge_end) => {
            dist := [0..n-1]
            queue := [0..n-1]
            [0..n-1] >> #(i) => {
                dist[i] = 0 - 1
            }
            dist[s] = 0
            queue[0] = s
            qh = 0
            qt = 1
            found = 0
            [...] >> ?(qh < qt && found == 0) => {
                u = queue[qh]
                qh = qh + 1
                ?(u == t) => {
                    answer = dist[u]
                    found = 1
                } | {
                    [0..m-1] >> #(e) => {
                        eu = values[4 + e + e]
                        ev = values[5 + e + e]
                        ?(eu == u) => {
                            ?(ev >= 0 && ev < n) => {
                                ?(dist[ev] < 0) => {
                                    dist[ev] = dist[u] + 1
                                    queue[qt] = ev
                                    qt = qt + 1
                                }
                            }
                        }
                    }
                }
            }
            ?(found == 0) => {
                answer = dist[t]
            }
        }
    }
}

>_(answer)
