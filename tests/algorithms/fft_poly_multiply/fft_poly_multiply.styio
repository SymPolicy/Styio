/* Multiply two integer polynomials (C++ FFT; Styio: schoolbook).
   Input: [n, m, a0..a{n-1}, b0..b{m-1}, then (n+m) product workspace zeros]
   Output: one coefficient per line (n+m-1 lines); empty factor -> empty stdout. */
values <- @stdin: list[i32]
ok = 0
L = 0
c_base = 0

?(values.length >= 2) => {
    n = values[0]
    m = values[1]
    need = 2 + n + m + (n + m)
    ?(n > 0 && m > 0 && values.length >= need) => {
        a_base = 2
        b_base = 2 + n
        c_base = 2 + n + m
        L = n + m - 1
        [0..L-1] >> #(i) => {
            values[c_base + i] = 0
        }
        [0..n-1] >> #(i) => {
            [0..m-1] >> #(j) => {
                values[c_base + i + j] = values[c_base + i + j] + values[a_base + i] * values[b_base + j]
            }
        }
        ok = 1
    }
}

?(ok == 1) => {
    [0..L-1] >> #(i) => {
        >_(values[c_base + i])
    }
}
