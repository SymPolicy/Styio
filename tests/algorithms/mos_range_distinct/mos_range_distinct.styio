/* Range distinct sum over queries (C++ Mo's; Styio: per-query scan).
   Input: [n, q, a0..a{n-1}, L1,R1,...,Lq,Rq]
   Inclusive [L,R]; malformed queries skipped; empty -> 0. */
values <- @stdin: list[i32]
answer = 0

?(values.length >= 2) => {
    n = values[0]
    q = values[1]
    ?(n >= 0 && q >= 0 && values.length >= 2 + n + q * 2) => {
        total = 0
        [0..q-1] >> #(qi) => {
            L = values[2 + n + qi * 2]
            R = values[2 + n + qi * 2 + 1]
            ?(L >= 0 && R >= 0 && L < n && R < n && L <= R) => {
                // count distinct via O((R-L+1)^2)
                dist = 0
                [L..R] >> #(i) => {
                    first = 1
                    ?(i > L) => {
                        [L..i-1] >> #(j) => {
                            ?(values[2 + j] == values[2 + i]) => {
                                first = 0
                            }
                        }
                    }
                    ?(first == 1) => {
                        dist = dist + 1
                    }
                }
                total = total + dist
            }
        }
        answer = total
    }
}

>_(answer)
