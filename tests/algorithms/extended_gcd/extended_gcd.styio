/* CLRS 31.2 Extended-Euclid: output g, x, y with a*x + b*y = g = gcd(|a|,|b|).
   Input: [a, b]
   Output: three lines g\nx\ny. Short input -> 0,0,0. */
values <- @stdin: list[i32]
g = 0
x = 0
y = 0

?(values.length >= 2) => {
    a = values[0]
    b = values[1]
    aa = a
    bb = b
    ?(aa < 0) => {
        aa = 0 - aa
    }
    ?(bb < 0) => {
        bb = 0 - bb
    }
    old_r = aa
    r = bb
    old_s = 1
    s = 0
    old_t = 0
    t = 1

    [...] >> ?(r != 0) => {
        q = old_r / r
        next_r = old_r - q * r
        old_r = r
        r = next_r
        next_s = old_s - q * s
        old_s = s
        s = next_s
        next_t = old_t - q * t
        old_t = t
        t = next_t
    }

    ?(a < 0) => {
        old_s = 0 - old_s
    }
    ?(b < 0) => {
        old_t = 0 - old_t
    }
    g = old_r
    x = old_s
    y = old_t
}

>_(g, x, y)
