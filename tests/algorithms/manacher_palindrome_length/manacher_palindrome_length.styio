/* Longest palindromic subarray length (C++ Manacher; Styio: expand-around-center).
   Input: [n, a1..an]
   Nested guards avoid eager index evaluation past bounds. */
values <- @stdin: list[i32]
answer = 0

?(values.length >= 1) => {
    n = values[0]
    ?(n <= 0) => {
        answer = 0
    } | {
        ?(values.length >= 1 + n) => {
            best = 0
            // odd centers
            [0..n-1] >> #(c) => {
                L = c
                R = c
                expanding = 1
                [...] >> ?(expanding == 1) => {
                    ?(L >= 0 && R < n) => {
                        ?(values[1 + L] == values[1 + R]) => {
                            cur = R - L + 1
                            ?(cur > best) => {
                                best = cur
                            }
                            L = L - 1
                            R = R + 1
                        } | {
                            expanding = 0
                        }
                    } | {
                        expanding = 0
                    }
                }
            }
            // even centers
            ?(n > 1) => {
                [0..n-2] >> #(c) => {
                    L = c
                    R = c + 1
                    expanding = 1
                    [...] >> ?(expanding == 1) => {
                        ?(L >= 0 && R < n) => {
                            ?(values[1 + L] == values[1 + R]) => {
                                cur = R - L + 1
                                ?(cur > best) => {
                                    best = cur
                                }
                                L = L - 1
                                R = R + 1
                            } | {
                                expanding = 0
                            }
                        } | {
                            expanding = 0
                        }
                    }
                }
            }
            answer = best
        }
    }
}

>_(answer)
