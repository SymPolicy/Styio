/* Closest pair squared distance (C++ divide-conquer; Styio: O(n^2) scan).
   Input: [n, x1,y1,...,xn,yn]
   n<2 / malformed -> -1. */
values <- @stdin: list[i32]
answer = 0 - 1

?(values.length >= 1) => {
    n = values[0]
    ?(n >= 2 && values.length >= 1 + n * 2) => {
        best = 2000000000
        [0..n-2] >> #(i) => {
            [i+1..n-1] >> #(j) => {
                dx = values[1 + i * 2] - values[1 + j * 2]
                dy = values[1 + i * 2 + 1] - values[1 + j * 2 + 1]
                d = dx * dx + dy * dy
                ?(d < best) => {
                    best = d
                }
            }
        }
        answer = best
    }
}

>_(answer)
