/* Matrix determinant (C++ Bareiss; Styio: Leibniz n! for n<=5).
   Input: [n, a00..a{n-1}{n-1}, then n perm + n used zeros]
   n<=0 or n>5 in Styio path -> 0. */
values <- @stdin: list[i32]
answer = 0

?(values.length >= 1) => {
    n = values[0]
    ?(n <= 0 || n > 5) => {
        answer = 0
    } | {
        need = 1 + n * n + n + n
        ?(values.length >= need) => {
            a_base = 1
            perm_base = 1 + n * n
            used_base = perm_base + n
            // iterative factorial enumeration via digits as mixed radix
            // Generate all perms with recursive-style stackless: use increasing permutation next_permutation loop
            // Init perm 0..n-1
            [0..n-1] >> #(i) => {
                values[perm_base + i] = i
                values[used_base + i] = 0
            }
            det = 0
            running = 1
            [...] >> ?(running == 1) => {
                // sign and product
                inv = 0
                [0..n-2] >> #(i) => {
                    [i+1..n-1] >> #(j) => {
                        ?(values[perm_base + i] > values[perm_base + j]) => {
                            inv = inv + 1
                        }
                    }
                }
                sign = 1
                ?(inv - (inv / 2) * 2 == 1) => {
                    sign = 0 - 1
                }
                prod = 1
                [0..n-1] >> #(i) => {
                    j = values[perm_base + i]
                    prod = prod * values[a_base + i * n + j]
                }
                det = det + sign * prod
                // next_permutation
                i = n - 2
                found = 0
                [...] >> ?(i >= 0 && found == 0) => {
                    ?(values[perm_base + i] < values[perm_base + i + 1]) => {
                        found = 1
                    } | {
                        i = i - 1
                    }
                }
                ?(found == 0) => {
                    running = 0
                } | {
                    j = n - 1
                    [...] >> ?(values[perm_base + j] <= values[perm_base + i]) => {
                        j = j - 1
                    }
                    tmp = values[perm_base + i]
                    values[perm_base + i] = values[perm_base + j]
                    values[perm_base + j] = tmp
                    L = i + 1
                    R = n - 1
                    [...] >> ?(L < R) => {
                        tmp = values[perm_base + L]
                        values[perm_base + L] = values[perm_base + R]
                        values[perm_base + R] = tmp
                        L = L + 1
                        R = R - 1
                    }
                }
            }
            answer = det
        }
    }
}

>_(answer)
