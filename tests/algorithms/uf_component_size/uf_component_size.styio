/* Union-Find component size of x after unions (path compression + size).
   Input: [n, m, x, u1,v1,..., then n parent + n size zeros]
   Malformed -> -1. */
values <- @stdin: list[i32]
answer = -1

?(values.length >= 3) => {
    n = values[0]
    m = values[1]
    x = values[2]
    edge_end = 3 + m * 2
    need = edge_end + n + n
    ?(n <= 0 || x < 0 || x >= n) => {
        answer = -1
    } | {
        ?(values.length >= need) => {
            parent_base = edge_end
            size_base = edge_end + n
            [0..n-1] >> #(i) => {
                values[parent_base + i] = i
                values[size_base + i] = 1
            }
            [0..m-1] >> #(e) => {
                u = values[3 + e * 2]
                v = values[3 + e * 2 + 1]
                ?(u >= 0 && u < n && v >= 0 && v < n) => {
                    // find u
                    a = u
                    [0..n-1] >> #(t) => {
                        p = values[parent_base + a]
                        ?(p != a) => {
                            // path halving
                            values[parent_base + a] = values[parent_base + p]
                            a = values[parent_base + a]
                        }
                    }
                    b = v
                    [0..n-1] >> #(t) => {
                        p = values[parent_base + b]
                        ?(p != b) => {
                            values[parent_base + b] = values[parent_base + p]
                            b = values[parent_base + b]
                        }
                    }
                    ?(a != b) => {
                        sa = values[size_base + a]
                        sb = values[size_base + b]
                        ?(sa < sb) => {
                            values[parent_base + a] = b
                            values[size_base + b] = sa + sb
                        } | {
                            values[parent_base + b] = a
                            values[size_base + a] = sa + sb
                        }
                    }
                }
            }
            // find x
            a = x
            [0..n-1] >> #(t) => {
                p = values[parent_base + a]
                ?(p != a) => {
                    values[parent_base + a] = values[parent_base + p]
                    a = values[parent_base + a]
                }
            }
            answer = values[size_base + a]
        }
    }
}

>_(answer)
