/* CLRS merge sort: bottom-up merge using a cloned tmp buffer (`tmp << l`).
   Loop guards use short-circuit `&&`; indices stay in range before indexing.
   I/O: sorted list[i32] (same contract as the C++ bottom-up oracle). */
l <- @stdin: list[i32]
n = l.length
tmp << l

?(n > 1) => {
    width = 1
    [...] >> ?(width < n) => {
        left = 0
        [...] >> ?(left < n) => {
            mid = left + width
            ?(mid > n) => {
                mid = n
            }
            right = left + width + width
            ?(right > n) => {
                right = n
            }

            i = left
            j = mid
            k = left
            [...] >> ?(i < mid && j < right) => {
                ?(l[i] <= l[j]) => {
                    tmp[k] = l[i]
                    i = i + 1
                } | {
                    tmp[k] = l[j]
                    j = j + 1
                }
                k = k + 1
            }
            [...] >> ?(i < mid) => {
                tmp[k] = l[i]
                i = i + 1
                k = k + 1
            }
            [...] >> ?(j < right) => {
                tmp[k] = l[j]
                j = j + 1
                k = k + 1
            }
            ?(right > left) => {
                [left..right-1] >> #(idx) => {
                    l[idx] = tmp[idx]
                }
            }

            left = left + width + width
        }
        width = width + width
    }
}

>_(l)
