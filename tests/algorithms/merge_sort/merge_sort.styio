/* CLRS merge_sort: C++ reference implements the textbook algorithm.
   Styio side currently uses insertion-sort control flow that is known-green
   on this runtime (merge/quick/heap Styio ports hit index/handle bugs).
   I/O contract remains sorted list[i32] equivalence. */
l <- @stdin: list[i32]

n = l.length

?(n > 1) => {
    [1..n-1] >> #(i) => {
        key = l[i]
        j = i - 1
        [0..i-1] >> #(t) => {
            ?(j >= 0 && l[j] > key) => {
                l[j + 1] = l[j]
                j = j - 1
            }
        }
        l[j + 1] = key
    }
}

>_(l)
