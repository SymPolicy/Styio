/* CLRS 32.2 Rabin-Karp: first match index (base=256, mod=101, verify hits).
   Input: [n, m, t1..tn, p1..pm]
   Empty pattern -> 0; no match / short -> -1. */
values <- @stdin: list[i32]
answer = -1
base = 256
mod = 101

?(values.length >= 2) => {
    n = values[0]
    m = values[1]
    need = 2 + n + m
    ?(m == 0) => {
        answer = 0
    } | {
        ?(n < 0 || m < 0) => {
            answer = -1
        } | {
            ?(values.length >= need) => {
                text_base = 2
                pat_base = 2 + n
                ?(m > n) => {
                    answer = -1
                } | {
                    h = 1
                    ?(m > 1) => {
                        [0..m-2] >> #(i) => {
                            h = (h * base) % mod
                        }
                    }
                    p = 0
                    t = 0
                    [0..m-1] >> #(i) => {
                        pv = values[pat_base + i] % mod
                        ?(pv < 0) => {
                            pv = pv + mod
                        }
                        tv = values[text_base + i] % mod
                        ?(tv < 0) => {
                            tv = tv + mod
                        }
                        p = (base * p + pv) % mod
                        t = (base * t + tv) % mod
                    }
                    found = -1
                    [0..n-m] >> #(s) => {
                        ?(found < 0) => {
                            ?(p == t) => {
                                ok = 1
                                [0..m-1] >> #(j) => {
                                    ?(values[text_base + s + j] != values[pat_base + j]) => {
                                        ok = 0
                                    }
                                }
                                ?(ok == 1) => {
                                    found = s
                                }
                            }
                            ?(s < n - m) => {
                                outv = values[text_base + s] % mod
                                ?(outv < 0) => {
                                    outv = outv + mod
                                }
                                inv = values[text_base + s + m] % mod
                                ?(inv < 0) => {
                                    inv = inv + mod
                                }
                                t = (base * (t - outv * h) + inv) % mod
                                ?(t < 0) => {
                                    t = t + mod
                                }
                            }
                        }
                    }
                    answer = found
                }
            }
        }
    }
}

>_(answer)
