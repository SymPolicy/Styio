/* Discrete log (C++ BSGS; Styio: brute a^x).
   Input: [a, b, p]. Smallest x>=0 with a^x ≡ b (mod p), else -1. */
values <- @stdin: list[i32]
answer = 0 - 1

?(values.length >= 3) => {
    a0 = values[0]
    b0 = values[1]
    p = values[2]
    ?(p <= 0) => {
        answer = 0 - 1
    } | {
        ?(p == 1) => {
            answer = 0
        } | {
            a = a0 - (a0 / p) * p
            ?(a < 0) => { a = a + p }
            b = b0 - (b0 / p) * p
            ?(b < 0) => { b = b + p }
            ?(b == 1 - (1 / p) * p) => {
                answer = 0
            } | {
                ?(a == 0) => {
                    ?(b == 0) => { answer = 1 } | { answer = 0 - 1 }
                } | {
                    cur = 1 - (1 / p) * p
                    found = 0
                    x = 0
                    [...] >> ?(found == 0 && x < p) => {
                        ?(cur == b) => {
                            answer = x
                            found = 1
                        }
                        cur = (cur * a) - ((cur * a) / p) * p
                        ?(cur < 0) => { cur = cur + p }
                        x = x + 1
                    }
                    ?(found == 0) => {
                        answer = 0 - 1
                    }
                }
            }
        }
    }
}

>_(answer)
